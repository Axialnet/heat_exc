# Environment configuration for CHO Heat Exchanger Monitoring Platform
# Copy to .env and adjust values as needed

# Database
DATABASE_PATH=webapp/data/cho_monitoring.db

# Data Source
V1_DATA_PATH=data/version_1/shell_tube_fouling_final.csv
SCENARIO_ID=T90_Q5.0

# Model
MODEL_PATH=models/stage1_v2/xgb_raw_3_CIPAware.joblib

# Thresholds
THRESHOLDS_PATH=config/thresholds.json

# Replay Settings
REPLAY_INTERVAL_SECONDS=1.0
REPLAY_LOOP=false

# Server
HOST=0.0.0.0
PORT=8000
